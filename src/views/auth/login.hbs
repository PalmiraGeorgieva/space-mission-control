<div class="auth-card glass-card">
  <div class="auth-logo">
    <div class="auth-logo-icon">🔐</div>
    <h2 class="auth-title">Mission Login</h2>
    <p class="auth-sub">Access the Space Mission Control Center</p>
  </div>
  <div class="neon-line"></div>
  <form action="/auth/login" method="POST">
    <div class="form-group">
      <label class="form-label">Email Address</label>
      <input type="text" class="form-input" name="email" placeholder="commander@spacectrl.com" />
    </div>
    <div class="form-group">
      <label class="form-label">Password</label>
      <input type="password" class="form-input" name="password" placeholder="••••••••" />
    </div>
    <button type="submit" class="btn-auth">🚀 Launch Session</button>
  </form>
  <p class="auth-footer">New to Mission Control? <a href="/auth/register">Request Access</a></p>
</div>