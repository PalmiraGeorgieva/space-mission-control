// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
   id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  missions          Mission[] @relation("MissionOwner")
  supportedMissions Mission[] @relation("MissionSupport")

  @@map("users")
}

model Mission {
   id          Int      @id @default(autoincrement())
  name        String
  type        String
  destination String
  imageUrl    String
  crew        Int
  launchDate  String
  duration    String
  description String
  createdAt   DateTime @default(now())

  ownerId Int
  owner   User @relation("MissionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  supportList User[] @relation("MissionSupport")

  @@map("missions")
}
